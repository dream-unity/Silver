{
  "name": "Silver Private Journal",
  "short_name": "Silver",
  "description": "A private, video-first journal stored on your device.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#eef0f4",
  "theme_color": "#eef0f4",
  "categories": ["lifestyle", "productivity"],
  "icons": [
    {
      "src": "./icons/silver-mark.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "New journal entry",
      "short_name": "New entry",
      "url": "./?new=1",
      "icons": [{"src":"./icons/silver-mark.svg","sizes":"any","type":"image/svg+xml"}]
    },
    {
      "name": "Record video",
      "short_name": "Video",
      "url": "./?new=video",
      "icons": [{"src":"./icons/silver-mark.svg","sizes":"any","type":"image/svg+xml"}]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {"title":"title","text":"text","url":"url"}
  }
}
